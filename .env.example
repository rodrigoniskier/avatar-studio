# Carregue no Bash: set -a; source .env; set +a
STUDIO_TTS=chatterbox
# Alternativa: qwen3, instalado com bash scripts/setup_generative.sh qwen3
STUDIO_LIPSYNC=musetalk
STUDIO_VIDEO=infinitetalk
STUDIO_VIDEO_SIZE=480
STUDIO_SCENE_SECONDS=15
STUDIO_DEVICE=cuda
STUDIO_SEED=42
STUDIO_CFG_WEIGHT=0.3
STUDIO_EXAGGERATION=0.5
STUDIO_DATA=data
STUDIO_MODELS=models
STUDIO_VENVS=.venvs
# Incremente se substituir pesos manualmente, especialmente do Chatterbox.
STUDIO_TTS_REVISION=default
# Obrigatório para servir na rede; gere com python -c 'import secrets; print(secrets.token_urlsafe(32))'
STUDIO_ACCESS_TOKEN=
